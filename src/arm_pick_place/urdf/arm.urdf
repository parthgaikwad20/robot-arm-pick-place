<?xml version="1.0"?>
<!--
  Simple 4-DOF arm with a 2-finger parallel gripper.
  Geometry (metres) is mirrored in arm_pick_place/kinematics.py:
    shoulder height H  = 0.10
    upper arm       L1 = 0.25
    forearm         L2 = 0.20
    wrist -> grasp  L3 = 0.10   (tool_link sits between the fingertips)
-->
<robot name="simple_arm">

  <material name="dark"><color rgba="0.15 0.15 0.18 1"/></material>
  <material name="orange"><color rgba="0.95 0.45 0.10 1"/></material>
  <material name="grey"><color rgba="0.70 0.72 0.75 1"/></material>

  <!-- ===================== base ===================== -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.025"/>
      <geometry><cylinder radius="0.08" length="0.05"/></geometry>
      <material name="dark"/>
    </visual>
  </link>

  <joint name="joint1_base_yaw" type="revolute">
    <parent link="base_link"/>
    <child link="link1"/>
    <origin xyz="0 0 0.05"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14" upper="3.14" effort="10" velocity="2.0"/>
  </joint>

  <link name="link1">
    <visual>
      <origin xyz="0 0 0.025"/>
      <geometry><cylinder radius="0.055" length="0.05"/></geometry>
      <material name="grey"/>
    </visual>
  </link>

  <!-- ===================== upper arm ===================== -->
  <joint name="joint2_shoulder" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>
    <origin xyz="0 0 0.05"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.0" upper="2.0" effort="10" velocity="2.0"/>
  </joint>

  <link name="link2">
    <visual>
      <origin xyz="0 0 0.125"/>
      <geometry><box size="0.05 0.05 0.25"/></geometry>
      <material name="orange"/>
    </visual>
  </link>

  <!-- ===================== forearm ===================== -->
  <joint name="joint3_elbow" type="revolute">
    <parent link="link2"/>
    <child link="link3"/>
    <origin xyz="0 0 0.25"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.6" upper="2.6" effort="10" velocity="2.0"/>
  </joint>

  <link name="link3">
    <visual>
      <origin xyz="0 0 0.10"/>
      <geometry><box size="0.04 0.04 0.20"/></geometry>
      <material name="orange"/>
    </visual>
  </link>

  <!-- ===================== wrist + gripper palm ===================== -->
  <joint name="joint4_wrist" type="revolute">
    <parent link="link3"/>
    <child link="link4"/>
    <origin xyz="0 0 0.20"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.6" upper="2.6" effort="10" velocity="2.0"/>
  </joint>

  <link name="link4">
    <visual>
      <origin xyz="0 0 0.02"/>
      <geometry><box size="0.04 0.12 0.04"/></geometry>
      <material name="dark"/>
    </visual>
  </link>

  <!-- fingers: each slides outward along +/-y. 0.0 = closed on a 4 cm cube -->
  <joint name="finger_left_joint" type="prismatic">
    <parent link="link4"/>
    <child link="finger_left"/>
    <origin xyz="0 0.025 0.04"/>
    <axis xyz="0 1 0"/>
    <limit lower="0.0" upper="0.03" effort="5" velocity="0.1"/>
  </joint>

  <link name="finger_left">
    <visual>
      <origin xyz="0 0 0.04"/>
      <geometry><box size="0.02 0.01 0.08"/></geometry>
      <material name="grey"/>
    </visual>
  </link>

  <joint name="finger_right_joint" type="prismatic">
    <parent link="link4"/>
    <child link="finger_right"/>
    <origin xyz="0 -0.025 0.04"/>
    <axis xyz="0 -1 0"/>
    <limit lower="0.0" upper="0.03" effort="5" velocity="0.1"/>
  </joint>

  <link name="finger_right">
    <visual>
      <origin xyz="0 0 0.04"/>
      <geometry><box size="0.02 0.01 0.08"/></geometry>
      <material name="grey"/>
    </visual>
  </link>

  <!-- grasp point between the fingers (the IK target) -->
  <joint name="tool_joint" type="fixed">
    <parent link="link4"/>
    <child link="tool_link"/>
    <origin xyz="0 0 0.10"/>
  </joint>
  <link name="tool_link"/>

</robot>
